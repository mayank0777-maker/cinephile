# ---------------------------------------------------------------
# Cinephile backend configuration
# Copy this file to ".env" (same folder) and adjust the values.
# Never commit your real .env file.
# ---------------------------------------------------------------

PORT=5000
NODE_ENV=development

# Local MongoDB (default) or a MongoDB Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/cinephile

# Long random string used to sign login tokens (min 16 chars).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Frontend + admin origins allowed by CORS (comma separated)
CLIENT_URLS=http://localhost:5173,http://localhost:5174

# Razorpay TEST mode keys: https://dashboard.razorpay.com/app/website-app-settings/api-keys
# The key secret stays on the server; only the key id is sent to the browser.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# When no Razorpay keys are set, "true" enables a clearly labelled demo gateway so the
# full booking flow can still be demonstrated. Ignored as soon as Razorpay keys are present.
ALLOW_DEMO_PAYMENTS=true

# Booking rules
SEAT_LOCK_MINUTES=8
CONVENIENCE_FEE_PER_TICKET=25
MAX_SEATS_PER_BOOKING=10
CANCELLATION_CUTOFF_HOURS=2
